{
  "name": "frontend",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:circular": "node scripts/check-circular.mjs",
    "lint": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth",
    "test:skipauth": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth",
    "test:realauth": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 SKIP_AUTH=false playwright test --project=chromium-real-auth",
    "test:headed": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth --headed",
    "test:debug": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth --debug",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config ../cucumber.mjs",
    "test:bdd": "node scripts/run-bdd.cjs",
    "test:bdd:skipauth": "cross-env SKIP_AUTH=true BACKEND_URL=http://127.0.0.1:18083 FRONTEND_URL=http://127.0.0.1:3002 node scripts/run-bdd.cjs",
    "test:bdd:realauth": "cross-env SKIP_AUTH=false BACKEND_URL=http://127.0.0.1:18083 FRONTEND_URL=http://127.0.0.1:3002 node scripts/run-bdd.cjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth --grep='@smoke'",
    "test:smoke:stack": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=chromium-skip-auth --grep='@smoke'",
    "test:visual": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 playwright test --project=visual",
    "test:visual:upload": "cross-env FRONTEND_URL=http://127.0.0.1:3002 BACKEND_URL=http://127.0.0.1:18083 ARGOS_UPLOAD_LOCAL=true playwright test --project=visual",
    "test:lighthouse": "lhci autorun",
    "test:all": "npm run test:unit && npm run test:skipauth && npm run test:bdd:skipauth && npm run test:realauth",
    "test:ci:smoke": "npm run test:unit && npm run test:smoke",
    "test:ci:full": "npm run test:unit && npm run test:skipauth && npm run test:bdd:skipauth && npm run test:realauth"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.69.1",
    "d3-force": "^3.0.0",
    "happy-dom": "^20.10.6",
    "ky": "^1.14.3",
    "three": "^0.184.0",
    "tippy.js": "^6.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^6.6.1",
    "@cucumber/cucumber": "^12.8.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.6.2",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "madge": "^8.0.0",
    "msw": "^2.13.4",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "svelte-eslint-parser": "^0.43.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.3",
    "vitest": "^3.2.6"
  }
}
