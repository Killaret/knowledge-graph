{
  "name": "frontend",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:cucumber": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config ../cucumber.mjs",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js --config ../cucumber.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:preload": "vitest run --config vitest.config.preload.ts",
    "test:preload:watch": "vitest --config vitest.config.preload.ts",
    "test:preload:coverage": "vitest run --config vitest.config.preload.ts --coverage",
    "test:e2e:preload": "playwright test tests/preload-full-cycle.spec.ts --config=playwright.config.e2e.ts",
    "test:e2e:preload:ui": "playwright test tests/preload-full-cycle.spec.ts --ui",
    "test:smoke": "playwright test --grep='@smoke'",
    "test:performance": "playwright test tests/performance/",
    "test:visual": "playwright test tests/visual/",
    "test:lighthouse": "lhci autorun",
    "test:all": "npm run test:unit && npm run test && npm run test:cucumber",
    "test:ci:smoke": "npm run test:unit && npm run test:smoke",
    "test:ci:full": "npm run test:unit && npm run test && npm run test:cucumber && npm run test:performance"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "ky": "^1.14.3",
    "three": "^0.184.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@argos-ci/cli": "^5.0.5",
    "@cucumber/cucumber": "^12.8.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.6.2",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.13.4",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "svelte-eslint-parser": "^0.43.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  }
}
