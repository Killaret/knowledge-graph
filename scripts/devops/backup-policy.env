# Canonical backup freshness policy for destructive Docker operations.
# Read by scripts/devops/guard-personal-data.py and by
# scripts/devops/check-personal-backup.{ps1,sh} — keep this file the only
# place where the threshold lives. The environment variable of the same
# name overrides the file for a single run.
KG_BACKUP_MAX_AGE_HOURS=24
