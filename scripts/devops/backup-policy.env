# Canonical backup policy for destructive Docker operations.
# Read by all backup consumers: backup-personal.{ps1,sh}, check-personal-backup.{ps1,sh},
# guard-personal-data.py and docker-compose.personal.yml (via environment).
# Keep this file the only committed place where the threshold and the default
# backup directory live. The environment variable of the same name overrides
# the file for a single run.
KG_BACKUP_MAX_AGE_HOURS=24
KG_BACKUP_DIR=Desktop/my items
