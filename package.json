{
  "name": "knowledge-graph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "cd frontend && npm run lint",
    "lint:backend": "cd backend && golangci-lint run",
    "format": "cd frontend && npm run format",
    "build-config": "node scripts/build-config.js",
    "test": "cd frontend && npm run test:unit",
    "clean:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/cleanup-logs.ps1",
    "clean:logs:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/cleanup-logs.ps1 -DryRun",
    "clean:logs:sh": "bash ./scripts/cleanup/cleanup-logs.sh",
    "clean:test-artifacts": "python ./scripts/cleanup/cleanup-test-artifacts.py",
    "clean:test-artifacts:dry": "python ./scripts/cleanup/cleanup-test-artifacts.py --dry-run",
    "lint:scripts": "python ./scripts/devops/lint-scripts.py"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.0.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.0.0",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "frontend/**/*.{svelte,ts,js}": [
      "cd frontend && npm run lint",
      "cd frontend && npm run format"
    ],
    "backend/**/*.go": [
      "cd backend && golangci-lint run --new-from-rev=HEAD~1"
    ]
  },
  "dependencies": {
    "thesvg": "^2.1.6"
  }
}
