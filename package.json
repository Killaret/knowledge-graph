{
  "name": "knowledge-graph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint": "cd frontend && npm run lint",
    "lint:backend": "cd backend && golangci-lint run",
    "format": "cd frontend && npm run format",
    "build-config": "node scripts/build-config.js",
    "test": "cd frontend && npm run test:unit",
    "clean:lunix": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/clean_and_compress_lunix.ps1 -Search -Compress -UseCompact",
    "clean:lunix:vhd": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/clean_and_compress_lunix.ps1 -Search -Compress",
    "clean:lunix:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/clean_and_compress_lunix.ps1 -Search -Compress -UseCompact -DryRun",
    "clean:lunix:sh": "bash ./scripts/cleanup/clean_and_compress_lunix.sh -c",
    "clean:lunix:sh:dry": "bash ./scripts/cleanup/clean_and_compress_lunix.sh --dry-run -c",
    "clean:docker:vhdx": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup/diskpart_compress_admin.ps1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.0.0",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.0.0",
    "tsx": "^4.21.0"
  },
  "lint-staged": {
    "frontend/**/*.{svelte,ts,js}": [
      "cd frontend && npm run lint",
      "cd frontend && npm run format"
    ],
    "backend/**/*.go": [
      "cd backend && golangci-lint run --new-from-rev=HEAD~1"
    ]
  },
  "dependencies": {
    "thesvg": "^2.1.6"
  }
}
