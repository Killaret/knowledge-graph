# Test stack defaults.
# Copy this file to `.env.test` and adjust to override test secrets.
# Do not commit `.env.test` — it is gitignored.

JWT_SECRET=test-jwt-secret-32-characters-long

TEST_POSTGRES_USER=kb_user
TEST_POSTGRES_PASSWORD=kb_password
TEST_POSTGRES_DB=knowledge_test

NLP_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

SKIP_AUTH=true
FRONTEND_PORT=3002

GRAPH_SERVICE_INTERNAL_TOKEN=test-internal-token

# Yandex OAuth is optional for the test stack.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
