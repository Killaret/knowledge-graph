# Database Configuration (REQUIRED)
DATABASE_URL=postgres://kb_user:kb_pass@localhost:5432/knowledge_base?sslmode=disable

# Redis Configuration
REDIS_URL=localhost:6379

# Server Configuration
PORT=8080

# Redis Configuration
REDIS_URL=redis:6379
REDIS_FLUSH_ON_STARTUP=false

# NLP Service Configuration
NLP_SERVICE_URL=http://localhost:8000
NLP_MODEL_NAME=all-MiniLM-L6-v2

# JWT Configuration (REQUIRED - change in production)
JWT_SECRET=

# Yandex OAuth Configuration (optional)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Testing/Development (optional)
SKIP_AUTH=false

# Graph Service Integration (optional, used for analytics)
GRAPH_SERVICE_URL=http://localhost:9091
GRAPH_SERVICE_INTERNAL_TOKEN=
GRAPH_SERVICE_TIMEOUT_SECONDS=5
