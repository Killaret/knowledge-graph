@startuml
skinparam linetype ortho
skinparam componentStyle rectangle
skinparam nodesep 60
skinparam ranksep 80

title Компонентная диаграмма — Backend (Go)

package "Interface Layer" {
    [HTTP Handlers] as API
}

' Примечание (DOC-AUDIT-2): Command/Query Bus в коде отсутствуют —
' HTTP-хэндлеры вызывают application-сервисы напрямую. «Event Bus» —
' это Publisher в Redis канал graph:events, а не in-memory шина.

package "Interface Layer" {
    [HTTP Handlers\n(notehandler, linkhandler, ...)] as API
}

package "Application Layer" {
    [Application Services\n(note, linkweight, recommendation,\nimport, draft, ...)] as AppSvc
    [Events Publisher\n(Redis graph:events)] as EvtBus
}

package "Domain Layer" {
    [Note & Link Aggregates] as Agg
    [TraversalService (BFS)] as Graph
    [Specifications] as Spec
}

package "Infrastructure Layer" {
    [PostgreSQL Repos] as DB
    [Redis Cache] as Cache
    [Asynq Worker] as Worker
    [NLP Client] as NLP
    [Graph-Service Client\n(HTTP :9091)] as GClient
}

' === Вертикальные связи ===
API --> AppSvc : call

AppSvc --> Agg : use
AppSvc --> EvtBus : publish
AppSvc --> DB : save
AppSvc --> NLP : call
AppSvc --> Worker : enqueue
AppSvc --> GClient : graph queries

Graph --> Agg
Spec --> Agg

' === Реализации (пунктир) ===
DB ..> Agg : implements
Worker ..> AppSvc : processes tasks
NLP ..> AppSvc : called
Cache ..> AppSvc : caches

@enduml