{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(npm run test:unit*)",
      "Bash(npm run test:coverage*)",
      "Bash(npm run check*)",
      "Bash(npm run lint*)",
      "Bash(npx vitest *)",
      "Bash(pytest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(docker compose ps*)",
      "Bash(docker ps*)"
    ],
    "deny": [
      "Bash(rm -rf backups*)",
      "Bash(rm -rf ./backups*)",
      "Bash(rm -rf huggingface_cache*)",
      "Bash(rm -rf ./huggingface_cache*)"
    ],
    "ask": [
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose -f docker-compose.personal.yml down*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/scripts/devops/guard-personal-data.py\"",
            "timeout": 15,
            "statusMessage": "Проверка бэкапа Personal-стека"
          }
        ]
      }
    ]
  }
}
