  "autoLoad": true,
  "defaultBehavior": {
    "alwaysUseAgentSkills": true,
    "alwaysUseToolsFromDocs": true,
    "alwaysWriteTests": true,
    "alwaysUpdateDocs": true,
    "alwaysCheckSecurity": true,
    "alwaysOptimizePerformance": true
