**Go table-driven tests (mandatory pattern):**
```go
func TestCreateNote(t *testing.T) {
    tests := []struct {
        name    string
        title   string
        wantErr bool
    }{
        {"valid note", "My Note", false},
        {"empty title", "", true},
    }
    for _, tt := range tests {
        t.Run(tt.name, func(t *testing.T) {
            note, err := NewNote(tt.title, "content")
            if tt.wantErr {
                require.Error(t, err)
            } else {
                require.NoError(t, err)
                require.Equal(t, tt.title, note.Title())
            }
        })
    }
}
```

