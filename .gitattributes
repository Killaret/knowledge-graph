# One line ending per file type. Editors of different agents must not turn a
# one-line change into a whole-file diff (BOARD-2).
*.sh text eol=lf
*.md text eol=lf
.windsurfrules text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.go text eol=lf
*.py text eol=lf
*.svelte text eol=lf
*.ps1 text eol=crlf
